  <desc id="rollDiagramDesc">Diagram showing the roll outer diameter, core diameter, label length and gap.</desc>
  <defs>
    <linearGradient id="rollFill" x1="0" x2="1">
      <stop offset="0" stop-color="#dceaff" />
      <stop offset="1" stop-color="#8fbaff" />
    </linearGradient>
  </defs>
  <circle cx="180" cy="145" r="105" fill="url(#rollFill)" stroke="#1769e0" stroke-width="4" />
  <circle cx="180" cy="145" r="38" fill="#fff" stroke="#5f6f85" stroke-width="4" />
  <line x1="75" y1="25" x2="285" y2="25" stroke="#132238" stroke-width="2" />
  <line x1="75" y1="17" x2="75" y2="33" stroke="#132238" stroke-width="2" />
  <line x1="285" y1="17" x2="285" y2="33" stroke="#132238" stroke-width="2" />
  <text x="180" y="16" text-anchor="middle" font-size="15" fill="#132238">Outer diameter (OD)</text>
  <line x1="142" y1="145" x2="218" y2="145" stroke="#132238" stroke-width="2" />
