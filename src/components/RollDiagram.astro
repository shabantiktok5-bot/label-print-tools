  <rect x="305" y="85" width="88" height="46" rx="6" fill="#fff" stroke="#1769e0" stroke-width="2" />
  <rect x="305" y="139" width="88" height="46" rx="6" fill="#fff" stroke="#1769e0" stroke-width="2" />
  <line x1="305" y1="132" x2="393" y2="132" stroke="#b42318" stroke-width="3" />
  <text x="349" y="113" text-anchor="middle" font-size="12" fill="#132238">Label length</text>
  <text x="349" y="151" text-anchor="middle" font-size="12" fill="#b42318">Gap</text>
  <text x="349" y="177" text-anchor="middle" font-size="12" fill="#132238">Next label</text>
  <line x1="393" y1="85" x2="393" y2="185" stroke="#132238" stroke-width="1.5" stroke-dasharray="4 4" />
  <text x="286" y="228" font-size="13" fill="#5f6f85">Pitch = label length + gap</text>
</svg>
