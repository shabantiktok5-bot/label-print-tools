---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbSchema, webApplicationSchema } from '../../lib/seo';
const title='Label Linear Run Calculator – Metres & Feet Required';
const description='Calculate the linear web length required for a label order from quantity, label pitch, labels across and optional setup waste. Results in metres and feet.';
const path='/production/label-linear-run-calculator/';
const crumbs=[{name:'Home',path:'/'},{name:'Production Calculators',path:'/production/'},{name:'Label Linear Run Calculator',path}];
---
<BaseLayout title={title} description={description} canonicalPath={path} schemas={[breadcrumbSchema(crumbs,Astro.site),webApplicationSchema({name:'Label Linear Run Calculator',description,path,site:Astro.site})]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Production Calculators',href:'/production/'},{name:'Label Linear Run'}]} />
  <section class="tool-page-head"><div class="container"><span class="eyebrow">Production length</span><h1>Label Linear Run Calculator</h1><p class="lead">Turn a finished label quantity into the linear metres or feet of web required for production.</p></div></section>
  <section class="container tool-layout"><div class="calculator"><form id="linear-run-form"><div class="form-grid">
    <div class="field"><label for="labelCount">Label quantity</label><input id="labelCount" name="labelCount" type="number" value="50000" min="1" step="1" required/></div>
    <div class="field"><label for="labelsAcross">Labels across</label><input id="labelsAcross" name="labelsAcross" type="number" value="2" min="1" step="1" required/></div>
    <div class="field"><label for="labelLength">Label length</label><div class="input-row"><input id="labelLength" name="labelLength" type="number" value="100" min="0" step="any" required/><select name="labelLengthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="gap">Gap</label><div class="input-row"><input id="gap" name="gap" type="number" value="3" min="0" step="any" required/><select name="gapUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field full"><label for="setupWaste">Setup / leader / trailer allowance</label><div class="input-row"><input id="setupWaste" name="setupWaste" type="number" value="20" min="0" step="any"/><select name="setupWasteUnit" class="unit"><option value="m">m</option><option value="ft">ft</option><option value="mm">mm</option></select></div></div>
  </div><div class="calc-actions"><button class="button primary" type="submit">Calculate linear run</button><button class="button secondary" type="reset">Reset</button></div><p id="error" class="error" role="alert"></p></form>
  <div id="result" class="result" hidden><span class="result-kicker">Required linear run</span><strong id="result-metres" class="result-main">—</strong><div class="result-grid"><div class="metric"><span>Feet</span><strong id="result-feet">—</strong></div><div class="metric"><span>Machine repeats</span><strong id="result-repeats">—</strong></div><div class="metric"><span>Repeat pitch</span><strong id="result-pitch">—</strong></div></div></div></div>
  <aside class="diagram-card"><h2>Quantity becomes repeats</h2><p>If labels run two or more across the web, each machine-direction repeat produces multiple finished labels. The calculator rounds repeats up so the requested quantity is covered.</p><svg viewBox="0 0 420 280" role="img" aria-label="Two labels across a moving web"><rect x="38" y="45" width="344" height="170" rx="16" fill="#eef4ff" stroke="#1769e0" stroke-width="3"/><g fill="#fff" stroke="#1769e0" stroke-width="2"><rect x="72" y="72" width="112" height="48" rx="6"/><rect x="202" y="72" width="112" height="48" rx="6"/><rect x="72" y="140" width="112" height="48" rx="6"/><rect x="202" y="140" width="112" height="48" rx="6"/></g><path d="M46 235h320" stroke="#132238" stroke-width="2"/><path d="M354 227l16 8-16 8" fill="none" stroke="#132238" stroke-width="2"/><text x="210" y="262" text-anchor="middle" fill="#5f6f85" font-size="15">Machine direction / linear run</text></svg></aside></section>
  <section class="content"><div class="narrow"><h2>Linear run formula</h2><p>The order quantity is divided by labels across and rounded up to whole repeats. Repeat pitch is label length plus the machine-direction gap. Setup allowance is added after the production length.</p><div class="formula">Repeats = ceil(quantity ÷ labels across)<br/>Linear run = repeats × (label length + gap) + setup allowance</div><h2>Why labels across matters</h2><p>A 50,000-label order running two across needs roughly half as many machine-direction repeats as the same order running one across. This affects material length and ribbon length, while web width changes separately.</p></div></section>
  <RelatedTools tools={[{title:'Label Web Width',href:'/production/label-web-width-calculator/',description:'Calculate the width required for the chosen number across.'},{title:'Roll Diameter',href:'/label-roll/roll-diameter-calculator/',description:'Convert required web length into a finished roll OD.'},{title:'Thermal Ribbon',href:'/thermal-printing/thermal-ribbon-calculator/',description:'Estimate ribbon quantity from the same pitch and count.'}]}/>
  <script>
    import { linearRunMm } from '../../lib/calculations';
    import { formatNumber } from '../../lib/units';
    import { lengthMm,num,rememberForm,setError,setText,showResult,hideResult } from '../../lib/calculator-ui';
    const form=document.getElementById('linear-run-form') as HTMLFormElement;rememberForm(form,'linear-run');
    function calculate(){setError('');try{const labelCount=num(form,'labelCount');const labelsAcross=num(form,'labelsAcross');const pitchMm=lengthMm(form,'labelLength','labelLengthUnit')+lengthMm(form,'gap','gapUnit');const setupWasteMm=lengthMm(form,'setupWaste','setupWasteUnit');const r=linearRunMm({labelCount,labelsAcross,pitchMm,setupWasteMm});setText('result-metres',`${formatNumber(r.runLengthMm/1000,2)} m`);setText('result-feet',`${formatNumber(r.runLengthMm/304.8,2)} ft`);setText('result-repeats',formatNumber(r.repeats,0));setText('result-pitch',`${formatNumber(pitchMm,2)} mm`);showResult();}catch(e){hideResult();setError(e instanceof Error?e.message:'Check the values and try again.');}}
    form.addEventListener('submit',e=>{e.preventDefault();calculate();});form.addEventListener('reset',()=>setTimeout(()=>hideResult(),0));calculate();
  </script>
</BaseLayout>
