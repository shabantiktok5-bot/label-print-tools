---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbSchema, webApplicationSchema } from '../../lib/seo';
const title='Label Web Width Calculator – Labels Across, Gap & Side Trim';
const description='Calculate required label web width from label width, number across, horizontal gap and side trim, or find how many labels fit across an available web.';
const path='/production/label-web-width-calculator/';
const crumbs=[{name:'Home',path:'/'},{name:'Production Calculators',path:'/production/'},{name:'Label Web Width Calculator',path}];
---
<BaseLayout title={title} description={description} canonicalPath={path} schemas={[breadcrumbSchema(crumbs,Astro.site),webApplicationSchema({name:'Label Web Width Calculator',description,path,site:Astro.site})]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Production Calculators',href:'/production/'},{name:'Label Web Width'}]} />
  <section class="tool-page-head"><div class="container"><span class="eyebrow">Across-web layout</span><h1>Label Web Width Calculator</h1><p class="lead">Calculate the web width required for a chosen number of labels across—or enter an available web width to find how many columns fit.</p></div></section>
  <section class="container tool-layout"><div class="calculator"><form id="web-width-form"><div class="form-grid">
    <div class="field"><label for="labelWidth">Label width</label><div class="input-row"><input id="labelWidth" name="labelWidth" type="number" value="75" min="0" step="any" required/><select name="labelWidthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="horizontalGap">Gap between columns</label><div class="input-row"><input id="horizontalGap" name="horizontalGap" type="number" value="3" min="0" step="any" required/><select name="horizontalGapUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="sideTrim">Side trim per edge</label><div class="input-row"><input id="sideTrim" name="sideTrim" type="number" value="5" min="0" step="any" required/><select name="sideTrimUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="across">Target labels across</label><input id="across" name="across" type="number" value="3" min="1" step="1" required/></div>
    <div class="field full"><label for="availableWebWidth">Available web width <span style="font-weight:500;color:var(--muted)">(optional)</span></label><div class="input-row"><input id="availableWebWidth" name="availableWebWidth" type="number" value="250" min="0" step="any"/><select name="availableWebWidthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div><small>If supplied, the result also shows the maximum labels that fit across.</small></div>
  </div><div class="calc-actions"><button class="button primary" type="submit">Calculate web width</button><button class="button secondary" type="reset">Reset</button></div><p id="error" class="error" role="alert"></p></form>
  <div id="result" class="result" hidden><span class="result-kicker">Required web width</span><strong id="result-width" class="result-main">—</strong><div class="result-grid"><div class="metric"><span>Required inches</span><strong id="result-inches">—</strong></div><div class="metric"><span>Maximum across in available web</span><strong id="result-max">—</strong></div><div class="metric"><span>Across-web gaps</span><strong id="result-gaps">—</strong></div></div></div></div>
  <aside class="diagram-card"><h2>Across-web geometry</h2><p>Total web width is the label widths plus the gaps between columns plus side trim on both edges.</p><svg viewBox="0 0 420 260" role="img" aria-label="Three labels across a web with gaps and side trim"><rect x="28" y="55" width="364" height="130" rx="14" fill="#eef4ff" stroke="#1769e0" stroke-width="3"/><g fill="#fff" stroke="#1769e0" stroke-width="2"><rect x="64" y="83" width="82" height="74" rx="5"/><rect x="169" y="83" width="82" height="74" rx="5"/><rect x="274" y="83" width="82" height="74" rx="5"/></g><text x="46" y="130" font-size="12" fill="#5f6f85" transform="rotate(-90 46 130)">trim</text><text x="376" y="130" font-size="12" fill="#5f6f85" transform="rotate(90 376 130)">trim</text><line x1="28" y1="215" x2="392" y2="215" stroke="#132238" stroke-width="2"/><text x="210" y="240" text-anchor="middle" font-size="14" fill="#132238">Required web width</text></svg></aside></section>
  <section class="content"><div class="narrow"><h2>Web width formula</h2><div class="formula">Required web = (label width × labels across) + (gap × (labels across − 1)) + (2 × side trim)</div><p>If you enter an available web width, the calculator solves the same geometry in reverse to show the maximum whole number of labels that fit across.</p><h2>What counts as side trim?</h2><p>Side trim is the unusable or intentionally retained material outside the outermost label columns. Your die-cutting and converting process may require more than the visual margin shown on a proof, so use the production value for your press or die.</p></div></section>
  <RelatedTools tools={[{title:'Label Linear Run',href:'/production/label-linear-run-calculator/',description:'Calculate the machine-direction material requirement.'},{title:'Labels Per Sheet',href:'/sheet-labels/labels-per-sheet-calculator/',description:'Solve a similar layout problem for sheets.'},{title:'Roll Diameter',href:'/label-roll/roll-diameter-calculator/',description:'Estimate finished OD after choosing a production quantity.'}]}/>
  <script>
    import { requiredWebWidthMm,maxLabelsAcross } from '../../lib/calculations';
    import { formatNumber } from '../../lib/units';
    import { lengthMm,num,rememberForm,setError,setText,showResult,hideResult } from '../../lib/calculator-ui';
    const form=document.getElementById('web-width-form') as HTMLFormElement;rememberForm(form,'web-width');
    function calculate(){setError('');try{const labelWidthMm=lengthMm(form,'labelWidth','labelWidthUnit');const horizontalGapMm=lengthMm(form,'horizontalGap','horizontalGapUnit');const sideTrimMm=lengthMm(form,'sideTrim','sideTrimUnit');const across=num(form,'across');const width=requiredWebWidthMm({labelWidthMm,horizontalGapMm,sideTrimMm,across});setText('result-width',`${formatNumber(width,2)} mm`);setText('result-inches',`${formatNumber(width/25.4,3)} in`);setText('result-gaps',formatNumber(Math.max(0,Math.floor(across)-1),0));const available=(form.elements.namedItem('availableWebWidth') as HTMLInputElement).value.trim();if(available){const availableWebWidthMm=lengthMm(form,'availableWebWidth','availableWebWidthUnit');setText('result-max',formatNumber(maxLabelsAcross({availableWebWidthMm,labelWidthMm,horizontalGapMm,sideTrimMm}),0));}else{setText('result-max','Add web width');}showResult();}catch(e){hideResult();setError(e instanceof Error?e.message:'Check the values and try again.');}}
    form.addEventListener('submit',e=>{e.preventDefault();calculate();});form.addEventListener('reset',()=>setTimeout(()=>hideResult(),0));calculate();
  </script>
</BaseLayout>
