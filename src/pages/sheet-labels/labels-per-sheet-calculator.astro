---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbSchema, webApplicationSchema } from '../../lib/seo';
const title='Labels Per Sheet Calculator – A4, Letter & Custom Layouts';
const description='Calculate how many labels fit on A4, US Letter or custom sheets. Compare normal and 90-degree rotated layouts with margins, horizontal gaps and vertical gaps.';
const path='/sheet-labels/labels-per-sheet-calculator/';
const crumbs=[{name:'Home',path:'/'},{name:'Sheet Label Tools',path:'/sheet-labels/'},{name:'Labels Per Sheet Calculator',path}];
---
<BaseLayout title={title} description={description} canonicalPath={path} schemas={[breadcrumbSchema(crumbs,Astro.site),webApplicationSchema({name:'Labels Per Sheet Calculator',description,path,site:Astro.site})]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Sheet Label Tools',href:'/sheet-labels/'},{name:'Labels Per Sheet'}]} />
  <section class="tool-page-head"><div class="container"><span class="eyebrow">Sheet layout optimizer</span><h1>Labels Per Sheet Calculator</h1><p class="lead">Compare normal and rotated layouts for A4, US Letter or a custom sheet. Add margins and label gaps to estimate real usable yield.</p></div></section>
  <section class="container tool-layout"><div class="calculator"><form id="sheet-form"><div class="form-grid">
    <div class="field full"><label for="preset">Sheet preset</label><select id="preset" name="preset"><option value="a4">A4 — 210 × 297 mm</option><option value="letter">US Letter — 8.5 × 11 in</option><option value="custom">Custom</option></select></div>
    <div class="field"><label for="sheetWidth">Sheet width</label><div class="input-row"><input id="sheetWidth" name="sheetWidth" type="number" value="210" min="0" step="any" required/><select name="sheetWidthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="sheetHeight">Sheet height</label><div class="input-row"><input id="sheetHeight" name="sheetHeight" type="number" value="297" min="0" step="any" required/><select name="sheetHeightUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="labelWidth">Label width</label><div class="input-row"><input id="labelWidth" name="labelWidth" type="number" value="50" min="0" step="any" required/><select name="labelWidthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="labelHeight">Label height</label><div class="input-row"><input id="labelHeight" name="labelHeight" type="number" value="30" min="0" step="any" required/><select name="labelHeightUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="horizontalGap">Horizontal gap</label><div class="input-row"><input id="horizontalGap" name="horizontalGap" type="number" value="2" min="0" step="any"/><select name="horizontalGapUnit" class="unit"><option value="mm">mm</option><option value="in">in</option></select></div></div>
    <div class="field"><label for="verticalGap">Vertical gap</label><div class="input-row"><input id="verticalGap" name="verticalGap" type="number" value="2" min="0" step="any"/><select name="verticalGapUnit" class="unit"><option value="mm">mm</option><option value="in">in</option></select></div></div>
    <div class="field"><label for="marginHorizontal">Left + right margin per side</label><div class="input-row"><input id="marginHorizontal" name="marginHorizontal" type="number" value="5" min="0" step="any"/><select name="marginHorizontalUnit" class="unit"><option value="mm">mm</option><option value="in">in</option></select></div></div>
    <div class="field"><label for="marginVertical">Top + bottom margin per side</label><div class="input-row"><input id="marginVertical" name="marginVertical" type="number" value="5" min="0" step="any"/><select name="marginVerticalUnit" class="unit"><option value="mm">mm</option><option value="in">in</option></select></div></div>
  </div><div class="calc-actions"><button class="button primary" type="submit">Calculate sheet layout</button><button class="button secondary" type="reset">Reset</button></div><p id="error" class="error" role="alert"></p></form>
  <div id="result" class="result" hidden><span class="result-kicker">Best layout</span><strong id="result-best" class="result-main">—</strong><div class="result-grid"><div class="metric"><span>Normal layout</span><strong id="result-normal">—</strong></div><div class="metric"><span>Rotated layout</span><strong id="result-rotated">—</strong></div><div class="metric"><span>Best utilization</span><strong id="result-util">—</strong></div></div></div></div>
  <aside class="diagram-card"><h2>Both orientations are checked</h2><p>A 90-degree rotation can increase sheet yield. The calculator independently tests both orientations rather than assuming the supplied label direction is best.</p><svg viewBox="0 0 420 280" role="img" aria-label="Sheet label normal and rotated layout comparison"><rect x="42" y="38" width="150" height="198" rx="8" fill="#fff" stroke="#1769e0" stroke-width="3"/><g fill="#eef4ff" stroke="#1769e0"><rect x="58" y="56" width="52" height="32"/><rect x="119" y="56" width="52" height="32"/><rect x="58" y="98" width="52" height="32"/><rect x="119" y="98" width="52" height="32"/></g><rect x="228" y="38" width="150" height="198" rx="8" fill="#fff" stroke="#0e7c66" stroke-width="3"/><g fill="#ecf9f5" stroke="#0e7c66"><rect x="244" y="56" width="32" height="52"/><rect x="285" y="56" width="32" height="52"/><rect x="326" y="56" width="32" height="52"/><rect x="244" y="118" width="32" height="52"/><rect x="285" y="118" width="32" height="52"/><rect x="326" y="118" width="32" height="52"/></g><text x="117" y="260" text-anchor="middle" fill="#5f6f85">normal</text><text x="303" y="260" text-anchor="middle" fill="#5f6f85">rotated</text></svg></aside></section>
  <section class="content"><div class="narrow"><h2>How the sheet yield is calculated</h2><p>Usable width and height are reduced by the selected margins. Whole labels are then fitted with the requested inter-label gaps. The same calculation is repeated after rotating each label by 90 degrees.</p><div class="formula">columns = floor((usable width + horizontal gap) ÷ (label width + horizontal gap))<br/>rows = floor((usable height + vertical gap) ÷ (label height + vertical gap))<br/>labels per sheet = columns × rows</div><h2>Production note</h2><p>This is a geometric layout estimate. Real presses and cutters may require gripper margins, registration marks, bleed, gutters or finishing clearance larger than the simple margins entered here.</p></div></section>
  <RelatedTools tools={[{title:'Label Web Width',href:'/production/label-web-width-calculator/',description:'Optimize labels across a continuous roll web.'},{title:'ZPL Label Size',href:'/thermal-printing/zpl-label-size-calculator/',description:'Convert the physical label size into printer dots.'},{title:'Label Linear Run',href:'/production/label-linear-run-calculator/',description:'Plan material length for roll production.'}]}/>
  <script>
    import { sheetLayout } from '../../lib/calculations';
    import { formatNumber } from '../../lib/units';
    import { lengthMm,rememberForm,setError,setText,showResult,hideResult } from '../../lib/calculator-ui';
    const form=document.getElementById('sheet-form') as HTMLFormElement;const preset=form.elements.namedItem('preset') as HTMLSelectElement;rememberForm(form,'labels-per-sheet');
    function setPreset(){if(preset.value==='a4'){(form.elements.namedItem('sheetWidth') as HTMLInputElement).value='210';(form.elements.namedItem('sheetHeight') as HTMLInputElement).value='297';(form.elements.namedItem('sheetWidthUnit') as HTMLSelectElement).value='mm';(form.elements.namedItem('sheetHeightUnit') as HTMLSelectElement).value='mm';}else if(preset.value==='letter'){(form.elements.namedItem('sheetWidth') as HTMLInputElement).value='8.5';(form.elements.namedItem('sheetHeight') as HTMLInputElement).value='11';(form.elements.namedItem('sheetWidthUnit') as HTMLSelectElement).value='in';(form.elements.namedItem('sheetHeightUnit') as HTMLSelectElement).value='in';}}
    function calculate(){setError('');try{const sheetWidthMm=lengthMm(form,'sheetWidth','sheetWidthUnit');const sheetHeightMm=lengthMm(form,'sheetHeight','sheetHeightUnit');const labelWidthMm=lengthMm(form,'labelWidth','labelWidthUnit');const labelHeightMm=lengthMm(form,'labelHeight','labelHeightUnit');const horizontalGapMm=lengthMm(form,'horizontalGap','horizontalGapUnit');const verticalGapMm=lengthMm(form,'verticalGap','verticalGapUnit');const mh=lengthMm(form,'marginHorizontal','marginHorizontalUnit');const mv=lengthMm(form,'marginVertical','marginVerticalUnit');const r=sheetLayout({sheetWidthMm,sheetHeightMm,labelWidthMm,labelHeightMm,marginLeftMm:mh,marginRightMm:mh,marginTopMm:mv,marginBottomMm:mv,horizontalGapMm,verticalGapMm});const best=r.best==='rotated'?r.rotated:r.normal;setText('result-best',`${best.count} labels / sheet`);setText('result-normal',`${r.normal.count} (${r.normal.columns} × ${r.normal.rows})`);setText('result-rotated',`${r.rotated.count} (${r.rotated.columns} × ${r.rotated.rows})`);setText('result-util',`${formatNumber(best.utilization*100,1)}%`);showResult();}catch(e){hideResult();setError(e instanceof Error?e.message:'Check the values and try again.');}}
    preset.addEventListener('change',()=>{setPreset();calculate();});form.addEventListener('submit',e=>{e.preventDefault();calculate();});form.addEventListener('reset',()=>setTimeout(()=>{hideResult();setPreset();calculate();},0));calculate();
  </script>
</BaseLayout>
