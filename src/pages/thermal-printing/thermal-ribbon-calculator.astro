---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbSchema, webApplicationSchema } from '../../lib/seo';
const title='Thermal Ribbon Calculator – Labels Per Ribbon & Ribbons Needed';
const description='Calculate labels per thermal-transfer ribbon and ribbons required from ribbon length, label pitch, labels across, waste allowance and target label quantity.';
const path='/thermal-printing/thermal-ribbon-calculator/';
const crumbs=[{name:'Home',path:'/'},{name:'Thermal Printing Tools',path:'/thermal-printing/'},{name:'Thermal Ribbon Calculator',path}];
---
<BaseLayout title={title} description={description} canonicalPath={path} schemas={[breadcrumbSchema(crumbs,Astro.site),webApplicationSchema({name:'Thermal Ribbon Calculator',description,path,site:Astro.site})]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Thermal Printing Tools',href:'/thermal-printing/'},{name:'Thermal Ribbon Calculator'}]} />
  <section class="tool-page-head"><div class="container"><span class="eyebrow">Thermal transfer planning</span><h1>Thermal Ribbon Calculator</h1><p class="lead">Estimate how many labels a ribbon can print and how many ribbons are needed for an order. Add a waste allowance for starts, stops and non-usable ribbon.</p></div></section>
  <section class="container tool-layout"><div class="calculator"><form id="ribbon-form"><div class="form-grid">
    <div class="field"><label for="ribbonLength">Ribbon length</label><div class="input-row"><input id="ribbonLength" name="ribbonLength" type="number" value="300" min="0" step="any" required/><select name="ribbonLengthUnit" class="unit"><option value="m">m</option><option value="ft">ft</option><option value="mm">mm</option></select></div></div>
    <div class="field"><label for="labelsAcross">Labels across</label><input id="labelsAcross" name="labelsAcross" type="number" value="1" min="1" step="1" required/></div>
    <div class="field"><label for="labelLength">Label length</label><div class="input-row"><input id="labelLength" name="labelLength" type="number" value="100" min="0" step="any" required/><select name="labelLengthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="gap">Gap / feed between labels</label><div class="input-row"><input id="gap" name="gap" type="number" value="3" min="0" step="any" required/><select name="gapUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="wastePercent">Ribbon waste allowance</label><div class="input-row"><input id="wastePercent" name="wastePercent" type="number" value="2" min="0" max="99" step="any"/><select class="unit" disabled aria-label="percent"><option>%</option></select></div></div>
    <div class="field"><label for="totalLabels">Target label quantity <span style="font-weight:500;color:var(--muted)">(optional)</span></label><input id="totalLabels" name="totalLabels" type="number" value="10000" min="1" step="1"/></div>
  </div><div class="calc-actions"><button class="button primary" type="submit">Calculate ribbon usage</button><button class="button secondary" type="reset">Reset</button></div><p id="error" class="error" role="alert"></p></form>
  <div id="result" class="result" hidden><span class="result-kicker">Estimated labels per ribbon</span><strong id="result-labels" class="result-main">—</strong><div class="result-grid"><div class="metric"><span>Usable ribbon length</span><strong id="result-length">—</strong></div><div class="metric"><span>Ribbons required</span><strong id="result-ribbons">—</strong></div><div class="metric"><span>Repeat pitch</span><strong id="result-pitch">—</strong></div></div></div></div>
  <aside class="diagram-card"><h2>Ribbon follows web travel</h2><p>This calculator estimates ribbon consumption from linear feed. It does not determine whether the ribbon is wide enough for your printed image; ribbon width must be checked separately against print coverage and printer specifications.</p><svg viewBox="0 0 420 260" role="img" aria-label="Thermal ribbon feeding over labels"><circle cx="88" cy="78" r="44" fill="#132238"/><circle cx="88" cy="78" r="14" fill="#fff"/><path d="M88 122 C110 160, 270 122, 338 160" fill="none" stroke="#132238" stroke-width="8"/><rect x="168" y="146" width="84" height="45" rx="5" fill="#fff" stroke="#1769e0" stroke-width="2"/><rect x="267" y="146" width="84" height="45" rx="5" fill="#fff" stroke="#1769e0" stroke-width="2"/><text x="210" y="222" text-anchor="middle" fill="#5f6f85" font-size="14">ribbon travel follows label pitch</text></svg></aside></section>
  <section class="content"><div class="narrow"><h2>Labels per ribbon formula</h2><p>Usable ribbon length is reduced by your waste percentage, then divided by label pitch. If multiple labels are printed across the web at the same time, each repeat can produce multiple labels.</p><div class="formula">Usable ribbon = ribbon length × (1 − waste %)<br/>Labels per ribbon = floor(usable ribbon ÷ pitch) × labels across<br/>Ribbons needed = ceil(target labels ÷ labels per ribbon)</div><h2>Why this is an estimate</h2><p>Some printers backfeed, pause, calibrate or leave leader/trailer ribbon that changes consumption. Use the waste field to match your own process after comparing the estimate with actual ribbon usage.</p></div></section>
  <RelatedTools tools={[{title:'Label Linear Run',href:'/production/label-linear-run-calculator/',description:'Calculate material travel for the same job.'},{title:'ZPL Label Size',href:'/thermal-printing/zpl-label-size-calculator/',description:'Convert physical label size into printer dots.'},{title:'Labels Per Roll',href:'/label-roll/labels-per-roll-calculator/',description:'Estimate labels available on the media roll.'}]}/>
  <script>
    import { thermalRibbonCapacity,ribbonsRequired } from '../../lib/calculations';
    import { formatNumber } from '../../lib/units';
    import { lengthMm,num,rememberForm,setError,setText,showResult,hideResult } from '../../lib/calculator-ui';
    const form=document.getElementById('ribbon-form') as HTMLFormElement;rememberForm(form,'thermal-ribbon');
    function calculate(){setError('');try{const ribbonLengthMm=lengthMm(form,'ribbonLength','ribbonLengthUnit');const pitchMm=lengthMm(form,'labelLength','labelLengthUnit')+lengthMm(form,'gap','gapUnit');const labelsAcross=num(form,'labelsAcross');const wastePercent=num(form,'wastePercent');const r=thermalRibbonCapacity({ribbonLengthMm,pitchMm,labelsAcross,wastePercent});setText('result-labels',formatNumber(r.labels,0));setText('result-length',`${formatNumber(r.usableLengthMm/1000,2)} m`);setText('result-pitch',`${formatNumber(pitchMm,2)} mm`);const target=(form.elements.namedItem('totalLabels') as HTMLInputElement).value.trim();setText('result-ribbons',target?formatNumber(ribbonsRequired({totalLabels:Number(target),labelsPerRibbon:r.labels}),0):'Add quantity');showResult();}catch(e){hideResult();setError(e instanceof Error?e.message:'Check the values and try again.');}}
    form.addEventListener('submit',e=>{e.preventDefault();calculate();});form.addEventListener('reset',()=>setTimeout(()=>hideResult(),0));calculate();
  </script>
</BaseLayout>
