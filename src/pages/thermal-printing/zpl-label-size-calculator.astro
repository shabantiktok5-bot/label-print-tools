---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { breadcrumbSchema, webApplicationSchema } from '../../lib/seo';
const title='ZPL Label Size Calculator – 203, 300 & 600 DPI Printer Dots';
const description='Convert label width and height from mm or inches to ZPL printer dots for 203, 300 or 600 DPI printers and generate ready-to-copy ^PW and ^LL values.';
const path='/thermal-printing/zpl-label-size-calculator/';
const crumbs=[{name:'Home',path:'/'},{name:'Thermal Printing Tools',path:'/thermal-printing/'},{name:'ZPL Label Size Calculator',path}];
---
<BaseLayout title={title} description={description} canonicalPath={path} schemas={[breadcrumbSchema(crumbs,Astro.site),webApplicationSchema({name:'ZPL Label Size Calculator',description,path,site:Astro.site})]}>
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Thermal Printing Tools',href:'/thermal-printing/'},{name:'ZPL Label Size'}]} />
  <section class="tool-page-head"><div class="container"><span class="eyebrow">ZPL dimensions</span><h1>ZPL Label Size Calculator</h1><p class="lead">Convert physical label size to printer dots and generate the basic ZPL width and label-length commands for 203, 300 or 600 DPI printers.</p></div></section>
  <section class="container tool-layout"><div class="calculator"><form id="zpl-form"><div class="form-grid">
    <div class="field"><label for="labelWidth">Label width</label><div class="input-row"><input id="labelWidth" name="labelWidth" type="number" value="100" min="0" step="any" required/><select name="labelWidthUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field"><label for="labelHeight">Label height</label><div class="input-row"><input id="labelHeight" name="labelHeight" type="number" value="150" min="0" step="any" required/><select name="labelHeightUnit" class="unit"><option value="mm">mm</option><option value="in">in</option><option value="cm">cm</option></select></div></div>
    <div class="field full"><label for="dpi">Printer resolution</label><select id="dpi" name="dpi"><option value="203">203 DPI (8 dots/mm)</option><option value="300">300 DPI (12 dots/mm)</option><option value="600">600 DPI (24 dots/mm)</option></select></div>
  </div><div class="calc-actions"><button class="button primary" type="submit">Convert to printer dots</button><button class="button secondary" id="copy-zpl" type="button">Copy ZPL</button><button class="button secondary" type="reset">Reset</button></div><p id="error" class="error" role="alert"></p></form>
  <div id="result" class="result" hidden><span class="result-kicker">Label dimensions in dots</span><strong id="result-dots" class="result-main">—</strong><div class="result-grid"><div class="metric"><span>^PW (print width)</span><strong id="result-pw">—</strong></div><div class="metric"><span>^LL (label length)</span><strong id="result-ll">—</strong></div><div class="metric"><span>Physical size</span><strong id="result-mm">—</strong></div></div><pre id="zpl-code" class="formula" style="margin-bottom:0">—</pre></div></div>
  <aside class="diagram-card"><h2>Physical size → dots</h2><p>ZPL positioning uses dots. The same physical label produces a different dot count at 203, 300 and 600 DPI, so use the actual printhead resolution configured for your printer.</p><svg viewBox="0 0 420 260" role="img" aria-label="Label grid representing printer dots"><rect x="88" y="38" width="244" height="174" rx="8" fill="#fff" stroke="#1769e0" stroke-width="3"/><g stroke="#dce4ef" stroke-width="1"><path d="M118 38v174M148 38v174M178 38v174M208 38v174M238 38v174M268 38v174M298 38v174"/><path d="M88 68h244M88 98h244M88 128h244M88 158h244M88 188h244"/></g><text x="210" y="240" text-anchor="middle" fill="#5f6f85" font-size="14">width and height become integer dot counts</text></svg></aside></section>
  <section class="content"><div class="narrow"><h2>mm to ZPL dots formula</h2><div class="formula">dots = round((millimetres ÷ 25.4) × DPI)</div><p>The tool rounds to the nearest whole dot because a thermal printhead cannot address a fraction of a dot. The output includes <code>^PW</code> for print width and <code>^LL</code> for label length.</p><h2>Common 4 × 6 label dimensions</h2><p>A nominal 4 × 6 inch label is 101.6 × 152.4 mm. At different print resolutions the physical size stays the same, while the dot dimensions change. Always confirm the printer's actual DPI and media calibration before assuming a ZPL template will transfer perfectly between printers.</p><div class="note"><strong>Note:</strong> This calculator generates size commands, not a complete shipping-label template. Printer offsets, darkness, speed, sensors and application-specific ZPL still need to be configured for your device.</div></div></section>
  <RelatedTools tools={[{title:'Thermal Ribbon Calculator',href:'/thermal-printing/thermal-ribbon-calculator/',description:'Plan ribbon consumption for the label.'},{title:'Label Web Width',href:'/production/label-web-width-calculator/',description:'Calculate converting web width from physical label width.'},{title:'Labels Per Sheet',href:'/sheet-labels/labels-per-sheet-calculator/',description:'Optimize the same physical size on sheets.'}]}/>
  <script>
    import { mmToDots } from '../../lib/calculations';
    import { formatNumber } from '../../lib/units';
    import { lengthMm,num,rememberForm,setError,setText,showResult,hideResult } from '../../lib/calculator-ui';
    const form=document.getElementById('zpl-form') as HTMLFormElement;rememberForm(form,'zpl-size');let latest='';
    function calculate(){setError('');try{const w=lengthMm(form,'labelWidth','labelWidthUnit');const h=lengthMm(form,'labelHeight','labelHeightUnit');const dpi=num(form,'dpi');const wd=mmToDots(w,dpi);const hd=mmToDots(h,dpi);latest=`^XA\n^PW${wd}\n^LL${hd}\n^XZ`;setText('result-dots',`${wd} × ${hd} dots`);setText('result-pw',`^PW${wd}`);setText('result-ll',`^LL${hd}`);setText('result-mm',`${formatNumber(w,2)} × ${formatNumber(h,2)} mm`);setText('zpl-code',latest);showResult();}catch(e){hideResult();setError(e instanceof Error?e.message:'Check the values and try again.');}}
    form.addEventListener('submit',e=>{e.preventDefault();calculate();});form.addEventListener('reset',()=>setTimeout(()=>hideResult(),0));document.getElementById('copy-zpl')?.addEventListener('click',async()=>{if(!latest)return;try{await navigator.clipboard.writeText(latest);const b=document.getElementById('copy-zpl');if(b){const old=b.textContent;b.textContent='Copied';setTimeout(()=>b.textContent=old,1200);}}catch{}});calculate();
  </script>
</BaseLayout>
